# =================================================================
# ESS CHATBOT SaaS — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================
# All values below are placeholder defaults. 
# DO NOT COMMIT REAL CREDENTIALS OR API KEYS TO SOURCE CONTROL.

# Application Environment
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://your-domain.com

# PostgreSQL & PgBouncer Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public&sslmode=prefer
DATABASE_URL="postgresql://postgres:your_secure_password_here@postgres:5432/ess_chatbot?schema=public"

# AI Inference Providers
# Default Provider: "groq", "ollama", "vllm", or "mock"
DEFAULT_AI_PROVIDER=groq

# Groq Cloud LPU Inference (Sub-second latency)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Local / Self-Hosted Ollama Inference
OLLAMA_URL="http://ollama:11434"
CHAT_MODEL="llama3.2:1b"

# Self-Hosted vLLM GPU Inference (OpenAI Compatible)
VLLM_URL="http://vllm:8000/v1"
VLLM_MODEL="meta-llama/Llama-3.2-3B-Instruct"

# Lead Generation & Webhook Dispatch
# Secret used to sign outgoing webhook payloads with HMAC SHA-256
LEAD_WEBHOOK_URL="https://your-crm.com/api/webhooks/leads"
LEAD_WEBHOOK_SECRET="whsec_your_hmac_sha256_shared_secret_here"

# Redis Cache & Rate Limiting (Multi-instance deployments)
REDIS_URL="redis://:your_redis_password_here@redis:6379"

# Security & CORS
# Allowed CORS origins for widget embedding (* or comma-separated domains)
ALLOWED_ORIGINS="https://visionexims.com,https://emperorsmartsolutions.com"
